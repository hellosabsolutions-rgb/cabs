# KABPRO Driver (Expo) — copy to `.env` and fill in values.
# Only EXPO_PUBLIC_* vars are available in app JS.

EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_BASE_URL_IOS=http://localhost:5001/api
EXPO_PUBLIC_API_BASE_URL_ANDROID=http://10.0.2.2:5001/api

EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

EXPO_PUBLIC_APP_NAME=KABPRO Driver

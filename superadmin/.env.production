# KABPRO superadmin — production (public URLs only, safe to commit)
# Used by: npm run build  and  GitHub Actions CI
#
# Login email/password are NOT set here. They live on the API:
#   server/.env.production  →  SUPERADMIN_EMAIL / SUPERADMIN_PASSWORD

VITE_API_URL=https://api.kabpro.pro/api
VITE_SOCKET_URL=https://api.kabpro.pro
VITE_APP_URL=https://superadmin.kabpro.pro

# Never bake demo credentials into production (overrides local .env)
VITE_SUPERADMIN_DEMO_EMAIL=
VITE_SUPERADMIN_DEMO_PASSWORD=
VITE_SUPERADMIN_DEMO_ROLE=

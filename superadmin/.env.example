# Superadmin (Vite) — copy values into `.env.development` / `.env.production`
# Vite loads `.env.[mode]` automatically. Do not put production login secrets here.

# ── Development ──────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_DEV_SERVER_URL=http://localhost:5000
VITE_APP_URL=http://localhost:3100

# Dev-only login hint — UI only shows when MODE=development
# Must match server/.env.development SUPERADMIN_EMAIL / SUPERADMIN_PASSWORD
VITE_SUPERADMIN_DEMO_EMAIL=superadmin@kabpro.com
VITE_SUPERADMIN_DEMO_PASSWORD=SuperAdmin@123
VITE_SUPERADMIN_DEMO_ROLE=superadmin

# ── Production (public URLs baked into the SPA) ──────────────────────────────
# VITE_API_URL=https://api.kabpro.pro/api
# VITE_SOCKET_URL=https://api.kabpro.pro
# VITE_APP_URL=https://superadmin.kabpro.pro
#
# Production login credentials go in server/.env.production:
#   SUPERADMIN_EMAIL=you@company.com
#   SUPERADMIN_PASSWORD=your-strong-password

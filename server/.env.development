# KABPRO server — local development
NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/kabpro

# Dev CORS (localhost auto-added; optional override)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CLIENT_URL=http://localhost:3000

PUBLIC_API_URL=http://localhost:5000

JWT_SECRET=dev-only-change-in-production
ACCESS_TOKEN_EXPIRE=15m

# Google Sign-In (must match admin VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=546992458715-dbhmfbb7bj36h6sfm2m4l8qjisdmd491.apps.googleusercontent.com

# Cloudinary (uploads / image compression)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin (FCM push) — place service account JSON in server/ (gitignored)
# or set an absolute/relative path:
# FIREBASE_SERVICE_ACCOUNT_PATH=./opsiva-e1ee5-firebase-adminsdk-fbsvc-0cb51d6e01.json
# FIREBASE_SERVICE_ACCOUNT_FILE=opsiva-e1ee5-firebase-adminsdk-fbsvc-0cb51d6e01.json

# Seed (development only — npm run seed)
SEED_ADMIN_EMAIL=admin@fleetos.com

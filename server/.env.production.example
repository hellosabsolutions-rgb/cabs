# ─────────────────────────────────────────────────────────────────────────────
# KABPRO server — production (THANOS)
# Copy to .env.production on server:  cp .env.production.example .env.production
# Never commit .env.production if it contains real secrets (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
# THANOS: use 5002 (Opsiva uses 5000–5005, 8080). Must match nginx proxy_pass.
PORT=5002

# MongoDB Atlas — do not install mongod on THANOS
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/kabpro?retryWrites=true&w=majority

# ── CORS (required) ─────────────────────────────────────────────────────────
# Comma-separated HTTPS origins — NO trailing slashes
# Must include every frontend that calls the API from the browser
CORS_ORIGINS=https://admin-kabpro.opsiva.in,https://kabpro.opsiva.in

# Legacy alias (merged into CORS) — primary admin app URL
CLIENT_URL=https://admin-kabpro.opsiva.in

# Used in emails / links (optional)
PUBLIC_API_URL=https://api-kabpro.opsiva.in

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE=15m

# Google Sign-In (must match admin VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=546992458715-dbhmfbb7bj36h6sfm2m4l8qjisdmd491.apps.googleusercontent.com

# ── Cloudinary (required for image/file uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# ── Firebase Admin (FCM push notifications) ───────────────────────────────────
# Place the service account JSON on the server (never commit) and point to it:
# FIREBASE_SERVICE_ACCOUNT_PATH=/srv/apps/cabs/server/opsiva-e1ee5-firebase-adminsdk-fbsvc-0cb51d6e01.json

# ── Domains reference ─────────────────────────────────────────────────────────
# API:     https://api-kabpro.opsiva.in
# Admin:   https://admin-kabpro.opsiva.in
# Landing: https://kabpro.opsiva.in
